{
  "manifest_version": 3,
  "name": "Bookmark Viewer",
  "version": "1.0.0",
  "description": "Replaces the new tab page with a list of all your bookmarks.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/image_low.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
